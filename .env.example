# Koneksi Neon pooled untuk runtime aplikasi; host biasanya mengandung -pooler.
DATABASE_URL="postgresql://USER:PASSWORD@POOLED-HOST:5432/miniedu?sslmode=require"
# Koneksi Neon direct ke database yang sama untuk Prisma migration; host tanpa -pooler.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT-HOST:5432/miniedu?sslmode=require"
# Wajib saat runtime production.
AUTH_SECRET="replace-with-at-least-32-random-characters"

# Hanya untuk pnpm db:seed (development/demo); tidak wajib di Vercel.
SEED_ADMIN_PASSWORD="replace-before-running-seed"
SEED_TEACHER_PASSWORD="replace-before-running-seed"
SEED_STUDENT_PASSWORD="replace-before-running-seed"
